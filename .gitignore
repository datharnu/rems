# Environment — NEVER commit secrets.
# Pattern matches .env at any depth (root, backend/, frontend/, etc.)
.env
.env.*
# Explicitly allow templates to be committed.
!.env.example
!.env.*.example

# Dependencies
node_modules/

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Misc
*.tgz
.nyc_output/
coverage/
